APP_NAME=Worldbridgers Regenify API
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
REGENIFY_POSTGRES_USER=YOUR_LOCAL_POSTGRES_USER
REGENIFY_POSTGRES_PASSWORD=YOUR_LOCAL_POSTGRES_PASSWORD
REGENIFY_POSTGRES_DB=YOUR_LOCAL_POSTGRES_DB
REGENIFY_NEO4J_AUTH=neo4j/YOUR_LOCAL_NEO4J_PASSWORD
POSTGRES_DSN=postgresql+psycopg://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_DB_HOST:5432/YOUR_DB_NAME
NEO4J_URI=neo4j+s://YOUR_NEO4J_HOST
NEO4J_USER=YOUR_NEO4J_USER
NEO4J_PASSWORD=YOUR_NEO4J_PASSWORD
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
BOOTSTRAP_ADMIN_EMAIL=admin@regenify.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-now
BOOTSTRAP_ADMIN_NAME=Platform Admin
VITE_BACKEND_API_BASE_URL=http://localhost:8000
